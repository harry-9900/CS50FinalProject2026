{
  "manifest_version": 3,
  "name": "DWS LEARN",
  "version": "1.0",
  "description": "A lightweight browser sidebar utility extension for learning.",
  "action": {
    "default_icon": "icons/DWSLOGO.png",
    "default_title": "Open DWS LEARN Sidebar"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/DWSLOGO 16.png",
    "48": "icons/DWSLOGO 48.png",
    "128": "icons/DWSLOGO 128.png"
  },
  "background": {
    "service_worker": "run.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ]
}